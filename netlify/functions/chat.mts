declare const Netlify:{env:{get(name:string):string|undefined}};
const ORDER_URL='https://script.google.com/macros/s/AKfycbxAUgxhXPbH_tHQuMgrCMmTsasO8CFOleeVKCcfZQlHPqEFcxnfauFgP1GhHMVLx2TKJQ/exec?v=4';
function clean(v:unknown){return String(v??'').trim().slice(0,700).replace(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/gi,'[email]').replace(/(?:\+?66|0)\d(?:[\s-]?\d){7,9}/g,'[phone]').replace(/[A-Za-z0-9_-]{32,}/g,'[token]')}
function out(body:unknown,status=200){return new Response(JSON.stringify(body),{status,headers:{'Content-Type':'application/json; charset=utf-8'}})}
const SYS=`คุณคือ YDML Web Assistant สำหรับโครงการ “มื้อนี้...มีความหมาย” ตอบภาษาไทยสั้น กระชับ ชัดเจน ห้ามเดาข้อมูลเฉพาะออเดอร์ ห้ามขอ password OTP access token tracking token หรือ API key ถ้าถามสถานะออเดอร์ให้ใช้ระบบ Tracking เดิม ถ้าต้องการสั่งอาหารให้เปิด ${ORDER_URL} ถ้าติดต่อทีมงานให้ใช้ LINE @ydml ถ้าไม่ทราบให้บอกว่าไม่มีข้อมูลเพียงพอ`;
async function viaMake(url:string,message:string,sessionId:string){const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message,session_id:sessionId,channel:'YDML_WEB_ASSISTANT',locale:'th-TH'})});const raw=await r.text();if(!r.ok)throw Error('MAKE '+r.status);try{const d=JSON.parse(raw);return String(d.reply??d.text??raw)}catch{return raw}}
async function viaGemini(key:string,message:string){const r=await fetch('https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent',{method:'POST',headers:{'Content-Type':'application/json','x-goog-api-key':key},body:JSON.stringify({system_instruction:{parts:[{text:SYS}]},contents:[{role:'user',parts:[{text:message}]}],generationConfig:{maxOutputTokens:350}})});const d:any=await r.json();if(!r.ok)throw Error('GEMINI '+r.status);return String(d?.candidates?.[0]?.content?.parts?.[0]?.text??'')}
export default async(req:Request)=>{if(req.method!=='POST')return out({error:'Method not allowed'},405);let d:any;try{d=await req.json()}catch{return out({error:'Invalid JSON'},400)}const message=clean(d?.message),sid=String(d?.session_id??'').slice(0,120);if(!message)return out({error:'Message is required'},400);if(/\bMM-\d{8}-[A-Z0-9-]+\b/i.test(message))return out({reply:'เพื่อความปลอดภัย ฉันไม่ตรวจสถานะออเดอร์จากเลขคำสั่งซื้อในแชต กรุณาใช้เมนู “ติดตามคำสั่งซื้อ” ในระบบ YDML หรือใช้ลิงก์ Tracking ที่ระบบออกให้'});try{const make=Netlify.env.get('MAKE_WEBHOOK_URL');const gem=Netlify.env.get('GEMINI_API_KEY');const reply=make?await viaMake(make,message,sid):gem?await viaGemini(gem,message):'';if(!reply)return out({error:'Assistant backend is not configured'},503);return out({reply:reply.slice(0,2000)})}catch(e){console.error(String(e));return out({error:'Assistant temporarily unavailable'},502)}};
export const config={path:'/api/chat'};